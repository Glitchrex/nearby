{
  "name": "nearby",
  "version": "0.1.0",
  "private": true,
  "description": "Find shops, groceries, malls, hospitals, pharmacies, restaurants and banks within a radius. Static, no backend, no API keys.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 8000 --directory src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vitest": "^4.1.11"
  }
}
